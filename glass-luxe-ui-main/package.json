{
  "name": "sanity-visual-editing-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:studio",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "dev:studio": "npm --workspace apps/studio run dev",
    "build:studio": "npm --workspace apps/studio run build",
    "check": "npm run build:web && npm run build:studio"
  }
}
