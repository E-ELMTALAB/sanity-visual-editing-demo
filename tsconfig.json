{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "**/*.bak",
    "**/*_old.tsx",
    "ProductDetail_old.tsx",
    "glass-luxe-ui-main",
    "lib/openaiClient.ts",
    "medusa-backend",
    "node_modules",
    "prev_ProductDetail.tsx",
    "sanity.config.ts",
    "sharif-ai-soft-main",
    "sharifgpt-website",
    "simple-payment-backend"
  ]
}
